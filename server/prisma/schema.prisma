// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Issue 3 — Create and seed IT request categories
// ---------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 3 — real authenticated User (replaces Lab 2's Development Requester,
// which was a testing mechanism only, not authentication).
// ---------------------------------------------------------------------------
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String   @unique
  passwordHash        String
  role                Role     @default(REQUESTER)
  isActive            Boolean  @default(true)
  mustChangePassword  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tickets             Ticket[] @relation("TicketRequester")
  ownedTickets        Ticket[] @relation("TicketOwner")
  publicComments      PublicComment[]
  internalNotes       InternalNote[]
}

// ---------------------------------------------------------------------------
// Lab 2 — Related System, Ticket, Attachment
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Lab 3 Issue #33: full workflow enum per specification.md §5.5's
// transition matrix (Lab 2 / Issue #30-#32 only ever used NEW).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id                Int           @id @default(autoincrement())
  ticketNumber      String        @unique
  requesterId       Int
  requester         User          @relation("TicketRequester", fields: [requesterId], references: [id])
  // Lab 3 Issue #32 (BR-14): the claim/reassign mutation lands in Issue
  // #33, but the Queue needs this column now to show/filter by owner.
  ticketOwnerId     Int?
  ticketOwner       User?         @relation("TicketOwner", fields: [ticketOwnerId], references: [id])
  categoryId        Int
  category          Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId   Int
  relatedSystem     RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  summary           String
  description       String
  requestedPriority Priority
  itPriority        Priority?
  currentStatus     TicketStatus  @default(NEW)
  // Lab 3 Issue #31 (BR-21/BR-22): a Requester-set signal that IT Staff
  // review, never a formal status change — see specification.md §5.5.
  requesterConfirmedResolved   Boolean   @default(false)
  requesterConfirmedResolvedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]

  @@index([requesterId])
  @@index([ticketOwnerId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([createdAt])
  @@index([currentStatus])
  @@index([itPriority])
}

// ---------------------------------------------------------------------------
// Lab 3 Issue #31 — Public Comments (BR-23 to BR-27): shared, append-only
// communication on a Ticket, visible to its Requester, IT Staff, and
// Administrator alike.
// ---------------------------------------------------------------------------
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Lab 3 Issue #33 — Internal Notes (BR-23 to BR-27): staff-only operational
// notes, append-only, never exposed on any Requester-facing endpoint.
// ---------------------------------------------------------------------------
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket    @relation(fields: [ticketId], references: [id])
  fileName      String
  storedPath    String
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime  @default(now())
  removedAt     DateTime?
  removalReason String?

  @@index([ticketId])
}